{
  "name": "Secure Agent Sandbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    // 1. Automatically install Node.js and npm into the container
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  // 1. Pass your host variables directly into the container environment
  "containerEnv": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ANTHROPIC_AUTH_TOKEN": "${localEnv:OPENROUTER_API_KEY}",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_MODEL": "openrouter/free",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "openrouter/free",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "openrouter/free",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "openrouter/free",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "openrouter/free",
    "CLAUDE_CODE_SUBAGENT_MODEL": "openrouter/free",
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0"
  },

  // 2. Automatically install Claude Code when the container is created
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code"
}
